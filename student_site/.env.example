# Copy these settings into your deployment environment; do not commit real secrets.
APP_ENV=production
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
COOKIE_SECURE=1
COOKIE_SAMESITE=lax
# Production defaults to same-origin framing only.
CSP_FRAME_ANCESTORS="'self'"

# Only needed when the site must run inside a cross-site preview iframe:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=1
# CSP_FRAME_ANCESTORS="'self' https://your-trusted-preview-host.example"
